MORMI_ENVIRONMENT=development
MORMI_DATABASE_URL=sqlite+aiosqlite:///./data/mormi.db
MORMI_ANTHROPIC_API_KEY=
MORMI_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
MORMI_SPEAKER_MODEL=claude-sonnet-4-6
MORMI_SPEAKER_TIMEOUT_SECONDS=8
MORMI_SPEAKER_VERIFIER_ENABLED=true
MORMI_SPEAKER_VERIFIER_TIMEOUT_SECONDS=1.8
# Optional after legacy `fernet:` dialogue rows have been converted to plaintext.
MORMI_RAW_DATA_ENCRYPTION_KEY=
MORMI_SERVICE_API_KEY=
# AI → Spring 관찰 이벤트 전송. 둘 다 설정된 경우에만 전송기가 시작됩니다.
MORMI_OBSERVATION_INGEST_URL=
MORMI_OBSERVATION_INGEST_KEY=
MORMI_OUTBOX_POLL_INTERVAL_SECONDS=2
MORMI_OUTBOX_BATCH_SIZE=20
MORMI_OUTBOX_REQUEST_TIMEOUT_SECONDS=5
MORMI_OUTBOX_RETRY_BASE_SECONDS=2
MORMI_OUTBOX_RETRY_MAX_SECONDS=300
MORMI_OUTBOX_LEASE_SECONDS=30
MORMI_IDEMPOTENCY_RETENTION_DAYS=30
MORMI_CORS_ORIGINS=["http://localhost:3000"]
MORMI_SHOW_INTERNAL_PEDAGOGY=false
