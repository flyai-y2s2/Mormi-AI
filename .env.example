MORMI_ENVIRONMENT=development
MORMI_DATABASE_URL=sqlite+aiosqlite:///./data/mormi.db
MORMI_ANTHROPIC_API_KEY=
MORMI_CLASSIFIER_MODEL=claude-sonnet-4-6
MORMI_CLASSIFIER_EFFORT=low
MORMI_BRIDGE_MODEL=claude-haiku-4-5-20251001
MORMI_SPEAKER_MODEL=claude-haiku-4-5-20251001
MORMI_SPEAKER_EFFORT=low
MORMI_STAR_NOTE_MODEL=claude-haiku-4-5-20251001
MORMI_REPORT_MODEL=claude-sonnet-4-6
# verdict-v1은 canary에 선정된 신규 집 9개와 카페·놀이동산 native scenario에 적용됩니다.
MORMI_RUNTIME_CONTRACT_VERSION=legacy-v1
MORMI_DIALOGUE_V2_CANARY_PERCENT=0
MORMI_DIALOGUE_V2_CANARY_SALT=mormi-dialogue-v2-default
# Optional session parent: independent from V2 selection. Keep disabled until
# revision 20260831_07 and the PostgreSQL multi-process release gate are verified.
# Percent enrolls NEW V2 conversations only. false bypasses enrolled parents too.
MORMI_SESSION_PARENT_GRAPH_ENABLED=false
MORMI_SESSION_PARENT_GRAPH_CANARY_PERCENT=0
# Bound ONLY optional cursor I/O; never changes model or canonical commit timeouts.
MORMI_SESSION_PARENT_STORE_TIMEOUT_SECONDS=0.5
MORMI_STABLE_COPY_MODEL=claude-sonnet-4-6
MORMI_STABLE_COPY_EFFORT=low
MORMI_STABLE_COPY_TIMEOUT_SECONDS=8
MORMI_STABLE_COPY_PROMPT_VERSION=stable-copy-v1
MORMI_STABLE_COPY_SCHEMA_VERSION=stable-copy-output-v1
MORMI_STABLE_COPY_VALIDATOR_VERSION=stable-copy-validator-v2
MORMI_STABLE_COPY_CACHE_LEASE_SECONDS=30
MORMI_STABLE_COPY_CACHE_RETRY_BASE_SECONDS=2
MORMI_STABLE_COPY_CACHE_RETRY_MAX_SECONDS=120
MORMI_CLASSIFIER_TIMEOUT_SECONDS=15
MORMI_SPEAKER_TIMEOUT_SECONDS=10
MORMI_BRIDGE_TIMEOUT_SECONDS=4
# Optional after legacy `fernet:` dialogue rows have been converted to plaintext.
MORMI_RAW_DATA_ENCRYPTION_KEY=
MORMI_SERVICE_API_KEY=
# Local/development/test diagnostics only. Never enable in production.
MORMI_SKIP_STARTUP_MAINTENANCE=false
# AI → Spring 관찰 이벤트 전송. 둘 다 설정된 경우에만 전송기가 시작됩니다.
MORMI_OBSERVATION_INGEST_URL=
MORMI_OBSERVATION_INGEST_KEY=
# BE가 star_note_created 수신 계약을 배포한 뒤 true로 전환합니다.
MORMI_STAR_NOTE_EVENTS_ENABLED=false
MORMI_OUTBOX_POLL_INTERVAL_SECONDS=2
MORMI_OUTBOX_BATCH_SIZE=20
MORMI_OUTBOX_REQUEST_TIMEOUT_SECONDS=5
MORMI_OUTBOX_RETRY_BASE_SECONDS=2
MORMI_OUTBOX_RETRY_MAX_SECONDS=300
MORMI_OUTBOX_LEASE_SECONDS=30
MORMI_IDEMPOTENCY_RETENTION_DAYS=30
MORMI_CORS_ORIGINS=["http://localhost:3000"]
MORMI_SHOW_INTERNAL_PEDAGOGY=false
# 교사용 사다리 분석 worker를 켤 때만 모델 디렉터리와 함께 설정합니다.
MORMI_LADDER_MODEL_DIR=
MORMI_LADDER_ANALYSIS_WORKER_ENABLED=false
MORMI_LADDER_ANALYSIS_POLL_INTERVAL_SECONDS=2
MORMI_LADDER_ANALYSIS_BATCH_SIZE=10
MORMI_LADDER_ANALYSIS_LEASE_SECONDS=60
